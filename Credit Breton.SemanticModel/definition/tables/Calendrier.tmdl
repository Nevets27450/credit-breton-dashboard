	column Année = YEAR([Date])
		dataType: int64
		formatString: 0
		lineageTag: 30dacd51-a0ac-40ab-bdb7-bb99464218f8
		summarizeBy: none

	column 'Numéro mois' = MONTH([Date])
		dataType: int64
		isHidden
		lineageTag: 5e51adb4-3b1e-4641-867d-a5863e253a6c
		summarizeBy: none

	column Mois = FORMAT([Date], "mmmm", "fr-FR")
		dataType: string
